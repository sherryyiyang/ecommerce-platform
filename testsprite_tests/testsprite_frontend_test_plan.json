  {
    "id": "TC013",
    "title": "Login and add a new product, then verify it appears in Admin list and Catalog",
    "description": "Verifies an authenticated user can add a product in Admin and see it listed in both Admin and the main catalog within the same session.",
    "category": "Admin Product Management",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the Email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the Password field"
      },
      {
        "type": "action",
        "description": "Click the Login button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      },
      {
        "type": "action",
        "description": "Click on \"Admin\" in the top navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/admin\""
      },
      {
        "type": "action",
        "description": "Click the \"Add Product\" button"
      },
      {
        "type": "action",
        "description": "Type \"Test Product Alpha\" into the product name field"
      },
      {
        "type": "action",
        "description": "Type \"A test-only product created by E2E\" into the description field"
      },
      {
        "type": "action",
        "description": "Type \"19.99\" into the price field"
      },
      {
        "type": "action",
        "description": "Type \"Test Category\" into the category field"
      },
      {
        "type": "action",
        "description": "Click the \"Save\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Test Product Alpha\" is visible"
      },
      {
        "type": "action",
        "description": "Click on \"Catalog\" (or \"Home\") in the top navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Test Product Alpha\" is visible"
      }
    ]
  },
