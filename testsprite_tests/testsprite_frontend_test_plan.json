[
  {
    "id": "TC001",
    "title": "Login succeeds with valid credentials and redirects to product catalog",
    "description": "Verifies a user can log in with the hardcoded valid account and is redirected to the product catalog.",
    "category": "User Login",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "assertion",
        "description": "Verify page title contains \"Login\""
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Product Catalog\" is visible"
      }
    ]
  },
