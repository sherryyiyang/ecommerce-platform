  {
    "id": "TC016",
    "title": "Add a new product successfully from Admin page",
    "description": "Verifies an authenticated user can add a product and see it appear in the admin list.",
    "category": "Admin Product Management",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      },
      {
        "type": "action",
        "description": "Click on the \"Admin\" link in the main navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/admin\""
      },
      {
        "type": "action",
        "description": "Click the \"Add product\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Add product\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"Test Product A\" into the Name field"
      },
      {
        "type": "action",
        "description": "Type \"A short description for Test Product A\" into the Description field"
      },
      {
        "type": "action",
        "description": "Type \"https://example.com/test-product-a.jpg\" into the Image field"
      },
      {
        "type": "action",
        "description": "Type \"19.99\" into the Price field"
      },
      {
        "type": "action",
        "description": "Type \"Test Category\" into the Category field"
      },
      {
        "type": "action",
        "description": "Click the \"Save\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Test Product A\" is visible"
      }
    ]
  },
