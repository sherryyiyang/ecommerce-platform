  {
    "id": "TC001",
    "title": "Browse catalog and open a product via View Details",
    "description": "Verifies a shopper can view the product list on the home page and navigate to a product details page via the View Details action.",
    "category": "Product Catalog",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to \"/\""
      },
      {
        "type": "assertion",
        "description": "Verify page title contains \"Product\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"View Details\" is visible"
      },
      {
        "type": "action",
        "description": "Click \"View Details\" for a product"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/product/\""
      },
      {
        "type": "assertion",
        "description": "Verify element \"Product details\" is visible"
      }
    ]
  },
