  {
    "id": "TC010",
    "title": "Direct login then buy from catalog shows success snackbar",
    "description": "Verifies an authenticated user can buy from the catalog and sees a purchase success snackbar.",
    "category": "Purchase Flow Simulation",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the Email input"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the Password input"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "action",
        "description": "Click on \"Buy\" for any visible product in the catalog"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Purchase successful\" is visible"
      }
    ]
  },
